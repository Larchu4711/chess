# Optional: enable AI stylization of uploaded photos.
# Point this at a serverless endpoint that accepts { image, style } and
# returns a stylized PNG. See api/stylize.ts for a reference implementation.
# When unset, the app runs fully with direct photo mapping (no AI, no key).
VITE_STYLIZE_ENDPOINT=

# Server-side only (used by api/stylize.ts). Never exposed to the browser.
OPENAI_API_KEY=
